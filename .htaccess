# Hostinger Node.js Application Routing

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Enforce HTTPS & 301 Redirect non-www (aelbd.net) to https://www.aelbd.net
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^aelbd\.net$ [NC]
    RewriteRule ^(.*)$ https://www.aelbd.net/$1 [L,R=301]

    # Mitigate CVE-2025-29927: prevent external spoofing of internal Next.js middleware header
    <IfModule mod_headers.c>
        RequestHeader unset x-middleware-subrequest
    </IfModule>

    # Serve existing static files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
</IfModule>

# Phusion Passenger native execution for Hostinger Node.js
<IfModule mod_passenger.c>
    PassengerEnabled on
    PassengerAppType node
    PassengerStartupFile server.js
    PassengerAppRoot "/home/u309337298/domains/aelbd.net/nodejs"
    PassengerBaseURI "/"
    PassengerNodejs "/opt/alt/alt-nodejs22/root/usr/bin/node"
</IfModule>
