# Hostinger Node.js Application Routing

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Enforce HTTPS & 301 Redirect www.aelbd.net to https://aelbd.net
    RewriteCond %{HTTP_HOST} ^www\.aelbd\.net$ [NC,OR]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://aelbd.net/$1 [L,R=301]

    # Mitigate CVE-2025-29927: prevent external spoofing of internal Next.js middleware header
    <IfModule mod_headers.c>
        RequestHeader unset x-middleware-subrequest
    </IfModule>

    # Serve existing static files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Forward all other requests (including /) to Node.js backend on port 3000
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>
