{
    "name": "garments-buying-house",
    "version": "1.0.1",
    "private": true,
    "scripts": {
        "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" next dev",
        "build": "npx prisma generate && cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" next build",
        "start": "next start -p $PORT",
        "seed": "npx prisma db seed",
        "db:push": "npx prisma db push",
        "db:reset": "npx prisma db push --force-reset && npx prisma db seed",
        "postinstall": "npx prisma generate",
        "lint": "next lint"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/nodemailer": "^7.0.11",
        "@types/unzipper": "^0.10.11",
        "adm-zip": "^0.6.1",
        "archiver": "^8.0.0",
        "bcrypt": "^5.1.1",
        "bcryptjs": "^3.0.3",
        "cross-env": "^10.1.0",
        "googleapis": "^178.0.0",
        "jspdf": "^4.2.0",
        "lucide-react": "^0.462.0",
        "next": "14.2.16",
        "next-auth": "^4.24.10",
        "nodemailer": "^7.0.13",
        "pdf-parse": "^2.4.5",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-dropzone": "^15.0.0",
        "telegram": "^2.26.22",
        "unzipper": "^0.12.5",
        "xlsx": "^0.18.5",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/archiver": "^8.0.0",
        "@types/bcrypt": "^5.0.2",
        "@types/node": "^22.9.3",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "autoprefixer": "^10.4.20",
        "eslint": "^8.57.0",
        "eslint-config-next": "14.2.16",
        "postcss": "^8.4.49",
        "prisma": "^5.22.0",
        "tailwindcss": "3.4.17",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.2"
    },
    "prisma": {
        "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
    }
}
