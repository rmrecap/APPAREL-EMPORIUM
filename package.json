{
    "name": "garments-buying-house",
    "version": "1.0.2",
    "private": true,
    "scripts": {
        "dev": "node node_modules/next/dist/bin/next dev",
        "build": "node node_modules/prisma/build/index.js generate && node node_modules/next/dist/bin/next build",
        "start": "node node_modules/next/dist/bin/next start -p $PORT",
        "seed": "npx prisma db seed",
        "db:push": "npx prisma db push",
        "db:reset": "npx prisma db push --force-reset && npx prisma db seed",
        "lint": "next lint"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/geoip-lite": "^1.4.4",
        "@types/unzipper": "^0.10.11",
        "adm-zip": "^0.6.1",
        "archiver": "^7.0.1",
        "cross-env": "^7.0.3",
        "bcryptjs": "^3.0.3",
        "geoip-lite": "^1.4.10",
        "googleapis": "^178.0.0",
        "jspdf": "^4.2.1",
        "lucide-react": "^0.462.0",
        "next": "15.5.27",
        "next-auth": "^4.24.15",
        "nodemailer": "^10.0.13",
        "pdf-parse": "^2.4.5",
        "prisma": "^5.22.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-dropzone": "^15.0.0",
        "telegram": "^2.26.22",
        "unzipper": "^0.12.5",
        "xlsx": "^0.18.5",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/archiver": "^6.0.3",
        "@types/node": "^22.9.3",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.26.0",
        "eslint-config-next": "15.5.27",
        "postcss": "^8.5.23",
        "tailwindcss": "3.4.17",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.2"
    },
    "overrides": {
        "postcss": "^8.5.23",
        "next-auth": {
            "nodemailer": "$nodemailer"
        }
    },
    "prisma": {
        "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
    }
}
