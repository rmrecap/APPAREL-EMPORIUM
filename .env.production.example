# ==========================================
# 1. APPLICATION & CANONICAL DOMAIN CONFIG
# ==========================================
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://aelbd.net
NEXTAUTH_URL=https://aelbd.net

# ==========================================
# 2. FAIL-CLOSED AUTHENTICATION SECRETS
# ==========================================
# DO NOT use default fallbacks. Generate via: openssl rand -base64 32
NEXTAUTH_SECRET=your_generated_production_nextauth_secret_key_32_chars
JWT_SECRET=your_generated_production_jwt_secret_key_32_chars

# ==========================================
# 3. DATABASE CONNECTION (Prisma / PostgreSQL or SQLite)
# ==========================================
DATABASE_URL="postgresql://aelbd_db_user:StrongPasswordHere@127.0.0.1:5432/aelbd_prod_db?schema=public&sslmode=prefer"

# ==========================================
# 4. EXTERNAL INTEGRATIONS & API KEYS
# ==========================================
API_EXTERNAL_KEY=your_production_api_external_secret_key
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=info@aelbd.net
# SMTP_PASS=your_email_password

# ==========================================
# 5. GOOGLE DRIVE AUTOMATED CLOUD BACKUP & RESTORE
# ==========================================
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_DRIVE_REFRESH_TOKEN="your_google_drive_refresh_token"
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id"
CRON_SECRET="your_secure_cron_secret"
