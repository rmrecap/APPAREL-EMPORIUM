# Database Configuration
# Using SQLite locally. For production (Hostinger VPS, etc.), change to PostgreSQL or MySQL
# Example: DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
DATABASE_URL="file:./dev.db"

# Next Auth Configuration
# NEXTAUTH_SECRET is required. Generate one securely using: openssl rand -base64 32
NEXTAUTH_SECRET="your_secure_generated_random_string_here_123!"
# The base URL of your application. E.g. https://www.globalstitch.com in production.
NEXTAUTH_URL="http://localhost:3000"

# Mailer / SMTP Configuration
# Required to send Outgoing Emails automatically upon Custom Form or RFQ submission
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="no-reply@yourdomain.com"
SMTP_PASSWORD="your_secure_smtp_password"
SMTP_FROM='"GlobalStitch System" <no-reply@yourdomain.com>'

# Tracking & Analytics (Optional, can also be configured inside Admin Dashboard)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_FB_PIXEL_ID="123456789012345"

# File Upload Constraints
# Max image size limit
NEXT_PUBLIC_MAX_FILE_SIZE="5242880" # 5MB in bytes

# ==============================================================================
# Google Drive Automated Cloud Backup System
# ==============================================================================
# Option 1: Google OAuth2 with Refresh Token (Recommended)
# Create OAuth 2.0 Credentials in Google Cloud Console with Google Drive API enabled.
# Generate Refresh Token using Google OAuth2 Playground (https://developers.google.com/oauthplayground)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your_google_client_secret"
GOOGLE_DRIVE_REFRESH_TOKEN="1//04your_google_drive_refresh_token"
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id" # ID of the Drive folder where backups should be stored

# Option 2: Google Service Account (Alternative to OAuth2)
# If using a Service Account, provide the raw JSON string or base64 encoded JSON
# Ensure the target Google Drive Folder is shared with the service account email (as Editor).
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Automated Backup Cron Secret (for scheduled midnight runs via Vercel Cron or Hostinger crontab)
CRON_SECRET="your_secret_cron_token_32_characters"
